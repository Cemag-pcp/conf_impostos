# Copie este arquivo para .env e preencha os valores reais
# Homologação para testes; URL local como fallback
INNOVARO_URL=https://hcemag.innovaro.com.br/sistema
INNOVARO_URL_FALLBACK=http://192.168.3.140/sistema
INNOVARO_USERNAME=
INNOVARO_PASSWORD=
INNOVARO_SLOW_MO_MS=250
INNOVARO_VIEWPORT_WIDTH=1366
INNOVARO_VIEWPORT_HEIGHT=800

# Pasta onde os relatórios baixados são salvos
DOWNLOAD_DIR=downloads

# Service account do Google (Sheets API) — valores do JSON de credenciais
# baixado no Google Cloud Console (IAM e admin > Contas de serviço > Chaves)
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_CERT_URL=

# ID da planilha Google que recebe os dados (abas "Baixas", "Resumo NFe", "Itens")
GOOGLE_SHEETS_ID=
